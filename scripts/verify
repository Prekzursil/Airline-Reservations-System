#!/usr/bin/env bash
set -euo pipefail

BUILD_DIR="${BUILD_DIR:-build}"
BUILD_TYPE="${BUILD_TYPE:-Debug}"
JOBS="${JOBS:-2}"
TEST_EXCLUDE="${TEST_EXCLUDE:-ReservationSystemTest\\.SwapSeatsInternal_DifferentFlights}"

cmake -S . -B "${BUILD_DIR}" \
  -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
  -DENABLE_COVERAGE=ON \
  -DCMAKE_CXX_STANDARD=17 \
  -DCMAKE_CXX_STANDARD_REQUIRED=ON
cmake --build "${BUILD_DIR}" -j"${JOBS}"
ctest --test-dir "${BUILD_DIR}" -C "${BUILD_TYPE}" --output-on-failure -E "${TEST_EXCLUDE}"
